{
  "name": "afterhours",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @afterhours/web dev",
    "worker": "pnpm --filter @afterhours/worker dev",
    "fixture": "tsx scripts/fixture.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "pnpm --filter @afterhours/web lint",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "build": "pnpm --filter @afterhours/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.28.2"
    }
  }
}
