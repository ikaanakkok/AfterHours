# Reference only. Run `pnpm setup` to generate a private .env with unique values.
AFTERHOURS_MODE=demo
AFTERHOURS_APP_URL=http://127.0.0.1:3000
AFTERHOURS_FIXTURE_URL=http://127.0.0.1:4001
POSTGRES_OWNER_PASSWORD=GENERATED_BY_SETUP
POSTGRES_APP_PASSWORD=GENERATED_BY_SETUP
POSTGRES_AUTH_PASSWORD=GENERATED_BY_SETUP
MIGRATION_DATABASE_URL=postgresql://afterhours_owner:GENERATED_BY_SETUP@127.0.0.1:55432/afterhours
DATABASE_URL=postgresql://afterhours_app:GENERATED_BY_SETUP@127.0.0.1:55432/afterhours
AUTH_DATABASE_URL=postgresql://afterhours_auth:GENERATED_BY_SETUP@127.0.0.1:55432/afterhours
BETTER_AUTH_SECRET=GENERATED_BY_SETUP
# Deployment-owned OAuth apps. Business owners use the Connect button, never these fields.
# Register AFTERHOURS_APP_URL + /api/channels/oauth/callback as the web redirect URI.
AFTERHOURS_GOOGLE_CLIENT_ID=
AFTERHOURS_GOOGLE_CLIENT_SECRET=
AFTERHOURS_MICROSOFT_CLIENT_ID=
AFTERHOURS_MICROSOFT_CLIENT_SECRET=
